{
  "name": "training-diary-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Training Diary iOS wrapper",
  "scripts": {
    "build": "vite build --config vite.config.mjs && node scripts/postbuild-web.cjs",
    "cap:copy": "npm run build && npx cap copy",
    "cap:ios:configure": "node scripts/configure-capacitor-ios.cjs",
    "cap:ios": "npm run build && npx cap sync ios && npm run cap:ios:configure"
  },
  "dependencies": {
    "@capacitor/app": "^7.1.2",
    "@capacitor/cli": "^7.4.4",
    "@capacitor/core": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/network": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "firebase": "^12.13.0",
    "lottie-web": "^5.13.0",
    "vite": "^8.0.14"
  }
}
