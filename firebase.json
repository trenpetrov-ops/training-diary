{
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**"
    ],
    "rewrites": [
      {
        "source": "/api/fatsecret/search",
        "function": "fatsecretSearch"
      },
      {
        "source": "/api/fatsecret/food",
        "function": "fatsecretFoodGet"
      },
      {
        "source": "/api/apple-health/import",
        "function": "appleHealthImport"
      },
      {
        "source": "/api/session/claim",
        "function": "claimExclusiveSession"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
