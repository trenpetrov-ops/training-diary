rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function clientLinkedTrainerAccess(appIdVal, clientUid) {
      return request.auth != null
        && exists(/databases/$(database)/documents/artifacts/$(appIdVal)/users/$(clientUid)/linkedTrainers/$(request.auth.uid))
        && get(/databases/$(database)/documents/artifacts/$(appIdVal)/users/$(clientUid)/linkedTrainers/$(request.auth.uid)).data.active == true;
    }

    function ownerOrLinkedTrainer(appIdVal, clientUid) {
      return isOwner(clientUid) || clientLinkedTrainerAccess(appIdVal, clientUid);
    }

    match /artifacts/{appId}/users/{userId} {
      allow read, write: if isOwner(userId);

      match /mealLibraryFoods/{foodId} {
        allow read, write: if isOwner(userId) || clientLinkedTrainerAccess(appId, userId);
      }

      match /mealLibraryRecipes/{recipeId} {
        allow read, write: if isOwner(userId) || clientLinkedTrainerAccess(appId, userId);
      }

      match /account/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /private/{docId} {
        allow read, write: if isOwner(userId);
      }

      match /healthDaily/{date} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /trainerInvites/{inviteId} {
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.trainerUid
          && request.resource.data.status == 'pending'
          && request.resource.data.keys().hasAll(['trainerUid', 'trainerClientCardId', 'status', 'createdAt']);
        allow read: if request.auth != null
          && (request.auth.uid == userId || resource.data.trainerUid == request.auth.uid);
        allow update: if request.auth != null
          && request.auth.uid == userId
          && resource.data.status == 'pending'
          && request.resource.data.trainerUid == resource.data.trainerUid
          && request.resource.data.trainerClientCardId == resource.data.trainerClientCardId
          && request.resource.data.status in ['accepted', 'rejected'];
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /linkedTrainers/{trainerUid} {
        allow read: if request.auth != null
          && (request.auth.uid == userId || request.auth.uid == trainerUid);
        allow create, delete: if isOwner(userId);
        // Клиент — полный контроль; тренер из связи может только дополнять allowedCycleIds (+ метка времени).
        allow update: if isOwner(userId)
          || (
            request.auth != null
            && request.auth.uid == trainerUid
            && resource.data.active == true
            && request.resource.data.active == true
            && request.resource.data.fullCycleAccess == resource.data.fullCycleAccess
            && request.resource.data.trainerClientCardId == resource.data.trainerClientCardId
            && request.resource.data.inviteId == resource.data.inviteId
            && request.resource.data.trainerFirstName == resource.data.trainerFirstName
            && request.resource.data.trainerLastName == resource.data.trainerLastName
            && request.resource.data.trainerName == resource.data.trainerName
            && request.resource.data.allowedCycleIds is list
            && resource.data.allowedCycleIds is list
            && request.resource.data.allowedCycleIds.hasAll(resource.data.allowedCycleIds)
          );
      }

      match /cycles/{cycleId} {
        allow read, write: if ownerOrLinkedTrainer(appId, userId);

        match /programs/{programId} {
          allow read, write: if ownerOrLinkedTrainer(appId, userId);
        }

        match /reports/{reportId} {
          allow read, write: if ownerOrLinkedTrainer(appId, userId);
        }

        match /supplements/{docId} {
          allow read, write: if ownerOrLinkedTrainer(appId, userId);
        }

        match /foods/{foodId} {
          allow read, write: if ownerOrLinkedTrainer(appId, userId);
        }

        match /meals/{mealId} {
          allow read, write: if ownerOrLinkedTrainer(appId, userId);
        }

        match /recipes/{recipeId} {
          allow read, write: if ownerOrLinkedTrainer(appId, userId);
        }
      }

      match /clients/{clientId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId);
        allow delete: if isOwner(userId)
          || (request.auth != null && resource.data.linkedUserUid == request.auth.uid);

        match /mealLibraryFoods/{foodId} {
          allow read, write: if isOwner(userId);
        }

        match /mealLibraryRecipes/{recipeId} {
          allow read, write: if isOwner(userId);
        }

        match /cycles/{cycleId} {
          allow read, write: if isOwner(userId);

          match /programs/{programId} {
            allow read, write: if isOwner(userId);
          }
          match /reports/{reportId} {
            allow read, write: if isOwner(userId);
          }
          match /supplements/{docId} {
            allow read, write: if isOwner(userId);
          }
          match /foods/{foodId} {
            allow read, write: if isOwner(userId);
          }
          match /meals/{mealId} {
            allow read, write: if isOwner(userId);
          }
          match /recipes/{recipeId} {
            allow read, write: if isOwner(userId);
          }
        }

        match /journal/{docId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /journal/{docId} {
        allow read, write: if ownerOrLinkedTrainer(appId, userId);
      }
    }

    match /artifacts/{appId}/publicUserCodes/{code} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasAll(['uid', 'assignedAt']);
      allow update, delete: if false;
    }

    match /artifacts/{appId}/appleHealthImportTokens/{tokenHash} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    // Общий каталог продуктов приложения (копии при создании у пользователя/клиента).
    match /artifacts/{appId}/globalFoodCatalog/{foodId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.keys().hasAll(['name', 'nameLower', 'createdByUid', 'createdAt']);
      allow update, delete: if request.auth != null
        && resource.data.createdByUid == request.auth.uid;
    }
  }
}
